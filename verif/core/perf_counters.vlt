`verilator_config
// Bench-only: keeps the signals the perf activity counters sample (fetched_core_tb.cpp) visible under fixed names.
public_flat_rd -module "cpu_top" -var "branch_redirect"
public_flat_rd -module "execution_backend" -var "issue_o"
public_flat_rd -module "execution_backend" -var "completion_id_o"
public_flat_rd -module "execution_backend" -var "resolve_accept_o"
public_flat_rd -module "execution_backend" -var "head_read"
public_flat_rd -module "execution_backend" -var "serial_accept"
public_flat_rd -module "reorder_buffer" -var "head_q"
public_flat_rd -module "reorder_buffer" -var "pc_q"
public_flat_rd -module "issue_queue" -var "valid_q"
public_flat_rd -module "load_store_unit" -var "launch_memory"
public_flat_rd -module "load_store_unit" -var "launch_forward"
public_flat_rd -module "load_store_unit" -var "store_buffer_full_o"
// the counters read l1_dcache under flat names, so it is inlined like the rest of the core
inline -module "l1_dcache"
public_flat_rd -module "l1_dcache" -var "response_valid_o"
public_flat_rd -module "l1_dcache" -var "start_miss"
public_flat_rd -module "l1_dcache" -var "state_q"
public_flat_rd -module "l1_dcache" -var "mem_request_ready_i"
public_flat_rd -module "l1_dcache" -var "enter"
public_flat_rd -module "l1_dcache" -var "next_access"
public_flat_rd -module "l1_dcache" -var "target_q"
public_flat_rd -module "l1_dcache" -var "walk_q"
// and fetch_unit with l1_icache, for the instruction-cache counters
inline -module "fetch_unit"
inline -module "l1_icache"
public_flat_rd -module "fetch_unit" -var "fill_take"
public_flat_rd -module "l1_icache" -var "hit_valid_o"
public_flat_rd -module "l1_icache" -var "miss_o"
public_flat_rd -module "l1_icache" -var "prefetch_valid_i"
public_flat_rd -module "l1_icache" -var "prefetch_ready_o"
public_flat_rd -module "l1_icache" -var "prefetch_hit_o"
public_flat_rd -module "l1_icache" -var "mem_request_valid_o"
public_flat_rd -module "l1_icache" -var "mem_request_ready_i"
public_flat_rd -module "l1_icache" -var "demand_miss"
public_flat_rd -module "l1_icache" -var "demand_valid_q"
public_flat_rd -module "l1_icache" -var "deliver"
public_flat_rd -module "l1_icache" -var "demand_line_q"
public_flat_rd -module "l1_icache" -var "stage_line_q"
public_flat_rd -module "l1_icache" -var "fill_valid_o"
public_flat_rd -module "l1_icache" -var "fill_fault_o"
public_flat_rd -module "l1_icache" -var "invalidate_i"
