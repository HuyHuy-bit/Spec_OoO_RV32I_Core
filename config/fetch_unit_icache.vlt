`verilator_config
lint_off -rule UNUSEDPARAM -file "*platform_pkg.sv"
lint_off -rule UNUSEDPARAM -file "*memory_protocol_pkg.sv"
// Bench-only: fetch_unit_icache_tb.cpp counts cache reads and outcomes under these flat names.
inline -module "l1_icache"
public_flat_rd -module "l1_icache" -var "lookup_valid_i"
public_flat_rd -module "l1_icache" -var "prefetch_valid_i"
public_flat_rd -module "l1_icache" -var "prefetch_ready_o"
public_flat_rd -module "l1_icache" -var "prefetch_read"
public_flat_rd -module "l1_icache" -var "prefetch_hit_o"
public_flat_rd -module "l1_icache" -var "hit_valid_o"
public_flat_rd -module "l1_icache" -var "miss_o"
public_flat_rd -module "l1_icache" -var "mem_request_valid_o"
public_flat_rd -module "l1_icache" -var "stage_valid_q"
public_flat_rd -module "l1_icache" -var "stage_prefetch_q"
